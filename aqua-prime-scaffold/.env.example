# Uniswap Trade API (server) — required for Jarvis tape + reference line
UNISWAP_API_KEY=

# 0G Compute Router (server) — optional; falls back to local heuristics
ZEROG_API_KEY=
ZEROG_ROUTER_URL=https://router-api.0g.ai/v1
ZEROG_MODEL=0gm-1.0-35b-a3b

# Optional: publish agent.attestation + prime.k/lambda to ENS after 0G propose
# ENS_WRITER_PRIVATE_KEY=
# ENS_RESOLVER_ADDRESS=

# Optional: pin public/agent/ to IPFS (yarn publish:agent / POST /api/jarvis/publish-agent)
# PINATA_JWT=
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs
# JARVIS_PUBLIC_PROPOSE_URL=https://YOUR_HOST/api/jarvis/propose

# Chain / wallet
NEXT_PUBLIC_CHAIN=fork
NEXT_PUBLIC_FORK_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Anvil fork upstream — archive-capable (Alchemy/Infura/Llama). Used by scripts/dev-aqua-prime.sh
# (script now loads this from .env.local). Do NOT use publicnode — archive storage 403s.
MAINNET_RPC_URL=
# Optional alias the script also accepts:
# NEXT_PUBLIC_MAINNET_RPC_URL=

# ENS (Jarvis soul + desk identity) — agent.model tips the 0G model when set
NEXT_PUBLIC_ENS_CHAIN=sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_JARVIS_ENS=jarvis.primedesk.eth

# Optional blotter
NEXT_PUBLIC_SUBGRAPH_URL=
